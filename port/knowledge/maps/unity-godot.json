{
  "from": "unity",
  "to": "godot",
  "title": "Unity (C#) → Godot 4 (GDScript)",
  "conventions": [
    "A MonoBehaviour becomes a GDScript attached to a node. The GameObject's components decide the node type: Rigidbody → RigidBody3D, CharacterController → CharacterBody3D, Collider with isTrigger → Area3D, plain → Node3D; colliders become CollisionShape3D children, MeshFilter+MeshRenderer a MeshInstance3D child.",
    "Prefabs become .tscn scenes; scene files (.unity) become .tscn scenes too. port_scene writes the .tscn with converted transforms; open it in Godot and attach meshes/materials.",
    "Coordinates: mirror Z (position (x, y, -z), quaternion (-x, -y, z, w)); Unity's +Z forward becomes Godot's -Z forward. Use port_convert.",
    "Unity Euler angles are degrees, Godot rotation is radians (rotation_degrees exists for degrees).",
    "Keep the port in C# instead (Godot .NET) when the code is large and idiomatic C#: target godot-csharp and only the engine API calls change.",
    "Assets: copy textures, audio and models (FBX/glTF) into the Godot project; Godot imports them itself. Unity-only formats (.mat, .controller, .anim) must be rebuilt."
  ],
  "entries": [
    { "id": "monobehaviour", "topic": "structure", "from": "public class X : MonoBehaviour", "to": "extends Node3D (or the node type the GameObject needs) + class_name X", "pattern": ":\\s*MonoBehaviour" },
    { "id": "awake-start", "topic": "lifecycle", "from": "Awake() / Start()", "to": "_ready() (use _enter_tree() for very early setup)", "pattern": "\\b(void\\s+)?(Awake|Start)\\s*\\(\\s*\\)" },
    { "id": "update", "topic": "lifecycle", "from": "Update() with Time.deltaTime", "to": "_process(delta)", "pattern": "\\bvoid\\s+Update\\s*\\(" , "leftover": "Time\\.deltaTime"},
    { "id": "fixed-update", "topic": "lifecycle", "from": "FixedUpdate() with Time.fixedDeltaTime", "to": "_physics_process(delta) (60 Hz default vs Unity 50 Hz)", "pattern": "\\bvoid\\s+FixedUpdate\\s*\\(" },
    { "id": "late-update", "topic": "lifecycle", "from": "LateUpdate()", "to": "_process with a higher process_priority on this node (runs later), or call_deferred", "pattern": "\\bvoid\\s+LateUpdate\\s*\\(" },
    { "id": "on-destroy", "topic": "lifecycle", "from": "OnDestroy() / OnDisable()", "to": "_exit_tree() / NOTIFICATION_PREDELETE in _notification", "pattern": "\\bvoid\\s+On(Destroy|Disable|Enable)\\s*\\(" },
    { "id": "serialize-field", "topic": "inspector", "from": "[SerializeField] private float speed = 6f; / public fields", "to": "@export var speed: float = 6.0", "pattern": "\\[SerializeField\\]|^\\s*public\\s+(float|int|bool|string|Vector3|GameObject|Transform)\\s+\\w+" },
    { "id": "get-component", "topic": "scene tree", "from": "GetComponent<T>() / GetComponentInChildren<T>()", "to": "the node itself (components are nodes): $Child, get_node(\"Child\") as T, or find_children(\"*\", \"T\")", "pattern": "GetComponent(InChildren|InParent)?<", "leftover": "GetComponent" },
    { "id": "find", "topic": "scene tree", "from": "GameObject.Find(\"X\") / transform.Find(\"X\")", "to": "get_node(\"X\") / get_tree().root.find_child(\"X\", true, false)", "pattern": "\\.Find\\(\"" },
    { "id": "instantiate", "topic": "scene tree", "from": "Instantiate(prefab, pos, rot, parent)", "to": "var n = scene.instantiate(); parent.add_child(n); n.global_transform = …", "pattern": "\\bInstantiate\\(", "leftover": "\\bInstantiate\\(" },
    { "id": "destroy", "topic": "scene tree", "from": "Destroy(gameObject) / Destroy(obj, t)", "to": "queue_free() / get_tree().create_timer(t).timeout.connect(queue_free)", "pattern": "\\bDestroy\\(", "leftover": "\\bDestroy\\(" },
    { "id": "set-active", "topic": "scene tree", "from": "gameObject.SetActive(false)", "to": "visible = false plus process_mode = PROCESS_MODE_DISABLED (or remove_child)", "pattern": "SetActive\\(" },
    { "id": "prefab-field", "topic": "resources", "from": "public GameObject bulletPrefab;", "to": "@export var bullet_scene: PackedScene (or const BULLET = preload(\"res://bullet.tscn\"))", "pattern": "public\\s+GameObject\\s+\\w+" },
    { "id": "resources-load", "topic": "resources", "from": "Resources.Load<T>(\"x\") / Addressables", "to": "load(\"res://x.tres\") / ResourceLoader.load_threaded_request", "pattern": "Resources\\.Load|Addressables\\." },
    { "id": "coroutine", "topic": "async", "from": "StartCoroutine(F()) with yield return new WaitForSeconds(t)", "to": "async func with await get_tree().create_timer(t).timeout", "pattern": "StartCoroutine\\(|IEnumerator|WaitForSeconds", "leftover": "WaitForSeconds|StartCoroutine" },
    { "id": "events", "topic": "events", "from": "event Action<int> Hit / UnityEvent", "to": "signal hit(damage: int); hit.emit(d); hit.connect(f)", "pattern": "\\bevent\\s+Action|UnityEvent", "leftover": "\\?\\.Invoke\\(" },
    { "id": "input-legacy", "topic": "input", "from": "Input.GetButtonDown(\"Fire1\") / Input.GetAxis(\"Horizontal\") / GetKey", "to": "Input.is_action_just_pressed(\"fire\") / Input.get_axis(\"move_left\", \"move_right\") (define actions in Project Settings → Input Map)", "pattern": "Input\\.Get(Button|Axis|Key|Mouse)", "leftover": "Input\\.Get(Button|Axis|Key)" },
    { "id": "input-system", "topic": "input", "from": "Input System (InputAction, PlayerInput)", "to": "Input Map actions + Input.is_action_* / _unhandled_input(event)", "pattern": "InputAction|PlayerInput" },
    { "id": "rigidbody", "topic": "physics", "from": "Rigidbody.AddForce(v, ForceMode.Impulse) / velocity", "to": "RigidBody3D.apply_central_impulse(v) / linear_velocity", "pattern": "AddForce\\(|Rigidbody\\b|\\.velocity\\b|linearVelocity" },
    { "id": "character-controller", "topic": "physics", "from": "CharacterController.Move(motion) / isGrounded", "to": "CharacterBody3D: velocity = …; move_and_slide(); is_on_floor()", "pattern": "CharacterController|\\.Move\\(|isGrounded" },
    { "id": "triggers", "topic": "physics", "from": "OnTriggerEnter(Collider other) / OnCollisionEnter(Collision c)", "to": "Area3D body_entered(body) signal / RigidBody3D body_entered with contact_monitor = true", "pattern": "On(Trigger|Collision)(Enter|Exit|Stay)" },
    { "id": "raycast", "topic": "physics", "from": "Physics.Raycast(origin, dir, out hit, dist)", "to": "get_world_3d().direct_space_state.intersect_ray(PhysicsRayQueryParameters3D.create(from, to)) or a RayCast3D node", "pattern": "Physics\\.Raycast" },
    { "id": "tags", "topic": "architecture", "from": "CompareTag(\"Enemy\") / FindGameObjectsWithTag", "to": "is_in_group(\"enemies\") / get_tree().get_nodes_in_group(\"enemies\")", "pattern": "CompareTag\\(|WithTag\\(|\\.tag\\b", "leftover": "CompareTag" },
    { "id": "singleton", "topic": "architecture", "from": "static Instance + DontDestroyOnLoad", "to": "Autoload (Project Settings → Globals) accessed by name", "pattern": "DontDestroyOnLoad|static\\s+\\w+\\s+Instance" },
    { "id": "scene-load", "topic": "architecture", "from": "SceneManager.LoadScene(\"x\")", "to": "get_tree().change_scene_to_file(\"res://x.tscn\")", "pattern": "SceneManager\\.LoadScene" },
    { "id": "scriptable-object", "topic": "data", "from": "ScriptableObject assets", "to": "custom Resource (extends Resource, class_name) saved as .tres", "pattern": "ScriptableObject" },
    { "id": "transform", "topic": "transform", "from": "transform.position / localPosition / rotation / eulerAngles", "to": "global_position / position / global_basis / rotation_degrees (mind the Z mirror)", "pattern": "transform\\.(position|localPosition|rotation|localRotation|eulerAngles)" },
    { "id": "forward", "topic": "transform", "from": "transform.forward (+Z)", "to": "-global_basis.z (Godot forward is -Z)", "pattern": "transform\\.forward|Vector3\\.forward" },
    { "id": "quaternion", "topic": "math", "from": "Quaternion.Euler(x, y, z) (degrees)", "to": "Basis.from_euler(Vector3(deg_to_rad(x), …)) / Quaternion.from_euler (radians)", "pattern": "Quaternion\\.Euler" },
    { "id": "debug-log", "topic": "debug", "from": "Debug.Log / LogWarning / LogError", "to": "print() / push_warning() / push_error()", "pattern": "Debug\\.Log", "leftover": "Debug\\.Log" },
    { "id": "mathf", "topic": "math", "from": "Mathf.Lerp, Mathf.Clamp, Random.Range", "to": "lerp, clamp, randf_range / randi_range (inclusive max)", "pattern": "Mathf\\.|Random\\.Range", "leftover": "Mathf\\." },
    { "id": "time", "topic": "time", "from": "Time.timeScale, Time.time", "to": "Engine.time_scale, Time.get_ticks_msec() / 1000.0", "pattern": "Time\\.(timeScale|time\\b|unscaledTime)" },
    { "id": "animator", "topic": "animation", "from": "Animator.Play / SetTrigger / SetFloat", "to": "AnimationPlayer.play() / AnimationTree with parameters/… conditions", "pattern": "Animator\\b|SetTrigger|SetFloat|SetBool" },
    { "id": "audio-source", "topic": "audio", "from": "AudioSource.Play / PlayOneShot", "to": "AudioStreamPlayer(3D).play()", "pattern": "AudioSource" },
    { "id": "ugui", "topic": "ui", "from": "Canvas, TextMeshProUGUI, Button.onClick", "to": "Control nodes: Label, Button.pressed signal, CanvasLayer", "pattern": "TextMeshPro|\\bCanvas\\b|onClick|UnityEngine\\.UI" },
    { "id": "collections", "topic": "language", "from": "List<T>, Dictionary<K,V>", "to": "Array[T], Dictionary (typed dictionaries in Godot 4.4+)", "pattern": "List<|Dictionary<" },
    { "id": "properties", "topic": "language", "from": "C# properties { get; set; }", "to": "var x: int: set = _set_x, get = _get_x (or plain vars)", "pattern": "\\{\\s*get;" }
  ]
}
