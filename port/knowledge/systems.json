{
  "about": "Rebuild knowledge for re_blueprint: which systems a kind of game or app is made of, and for each system the parameters to measure on the original so a rebuild matches it in function and feel. Archetypes are matched on genres, tags, categories and descriptions (lower-case substrings). Measurements are taken by observing the original (playing or using it, recorded video, screenshots), never by copying its files.",
  "method": {
    "capture": [
      "Record the original at a fixed resolution (e.g. 1920×1080) and 60 fps, with input display on if possible; keep the raw recordings.",
      "Screenshot every screen, menu and state at the same resolution; name them by screen id.",
      "Note the settings used (difficulty, graphics, controller or keyboard) so the rebuild is compared under the same conditions."
    ],
    "measure": [
      "Time: step through the video frame by frame; frames ÷ 60 = seconds. Measure every duration three times and take the median.",
      "Distance and speed: use something of known size in the scene (character height, tile, door, car length) as the ruler; speed = distance ÷ time over a straight stretch.",
      "Curves (acceleration, jump arcs, easing, camera follow): sample the position every 2–4 frames into a table and fit the curve; store the samples, not only the fit.",
      "Screen layout: measure positions and sizes as a fraction of screen height (resolution-independent); pick colors as hex.",
      "Input feel: count frames from button press (input display) to the first visible reaction.",
      "Rules and numbers (damage, prices, cooldowns, drop rates): read them from in-game UI and public wikis; for probabilities count over many trials."
    ],
    "verify": [
      "Record the rebuild with the same settings and resolution; put it side by side with the original or overlay at 50% opacity.",
      "Every measured parameter gets a tolerance (default ±5% or ±1 frame) and passes only when the rebuild is inside it.",
      "Blind test: someone who knows the original plays both and names what feels different; turn every remark into a parameter."
    ]
  },
  "cleanRoom": {
    "free": [
      "mechanics, rules and systems",
      "numbers and timings (measured)",
      "screen flow and layout proportions",
      "genre conventions, controls, camera behaviour",
      "the feel: acceleration curves, input response, game juice"
    ],
    "own": [
      "all code (written new, not translated from the original's decompiled code)",
      "all art, models, textures, animations",
      "all audio and music",
      "all text: names, dialogue, item and level names",
      "the product name, logo and icon"
    ],
    "never": [
      "copying or extracting the original's assets, code or level files into the rebuild",
      "names, logos or trade dress close enough to be mistaken for the original",
      "bypassing encryption, DRM or licence checks"
    ],
    "note": "Precise functional rebuilds of mechanics are a long-standing practice in games and software; copyright protects the expression (code, art, audio, text), and trademarks protect names and look. When you own the original, re_scan/re_archive may help you understand its structure, but its files stay out of the rebuild."
  },
  "core": {
    "game": [
      {
        "id": "game-loop",
        "name": "Game loop and states",
        "build": "Boot → title → main menu → gameplay → pause → game over/results → back; scene/state manager; fixed physics tick.",
        "measure": [
          {
            "param": "boot_to_title_s",
            "unit": "s",
            "how": "time from launch to the first interactive screen"
          },
          {
            "param": "fade_duration_s",
            "unit": "s",
            "how": "screen transition length"
          },
          {
            "param": "physics_hz",
            "unit": "Hz",
            "how": "engine default of the original (footprint) unless motion steps show otherwise"
          }
        ]
      },
      {
        "id": "input",
        "name": "Input and controls",
        "build": "Action map (keyboard/mouse, gamepad, touch), rebinding, dead zones, buffering.",
        "measure": [
          {
            "param": "input_latency_frames",
            "unit": "frames",
            "how": "press → first reaction"
          },
          {
            "param": "stick_deadzone",
            "unit": "0–1",
            "how": "smallest stick tilt that moves the character"
          },
          {
            "param": "input_buffer_frames",
            "unit": "frames",
            "how": "press slightly early before landing/recovery: does it still trigger?"
          }
        ]
      },
      {
        "id": "camera",
        "name": "Camera",
        "build": "Follow, framing, dead zone, look-ahead, smoothing, shake, FOV.",
        "measure": [
          {
            "param": "fov_deg",
            "unit": "deg (vertical)",
            "how": "from known object size at known distance, or the settings menu"
          },
          {
            "param": "follow_lag_s",
            "unit": "s",
            "how": "time for the camera to settle after the player stops"
          },
          {
            "param": "deadzone_frac",
            "unit": "screen fraction",
            "how": "how far the player moves before the camera moves"
          },
          {
            "param": "shake_amp_px_duration_s",
            "unit": "px, s",
            "how": "on hits/explosions"
          }
        ]
      },
      {
        "id": "hud-ui",
        "name": "HUD and menus",
        "build": "Every screen from the screenshots, same layout proportions and navigation order; own art and font.",
        "measure": [
          {
            "param": "screens",
            "unit": "list",
            "how": "every screen id with its screenshot"
          },
          {
            "param": "layout_fracs",
            "unit": "screen fraction",
            "how": "position and size of each HUD element"
          },
          {
            "param": "menu_nav_order",
            "unit": "list",
            "how": "focus order with keyboard/gamepad"
          }
        ]
      },
      {
        "id": "audio",
        "name": "Audio and feedback",
        "build": "Own sounds and music on the same events; mixing levels; ducking.",
        "measure": [
          {
            "param": "sfx_events",
            "unit": "list",
            "how": "every action that plays a sound, with its timing relative to the action"
          },
          {
            "param": "music_states",
            "unit": "list",
            "how": "when music changes (menu, combat, boss, victory)"
          }
        ]
      },
      {
        "id": "save-settings",
        "name": "Save, progress and settings",
        "build": "What is saved and when (checkpoints, autosave), settings menu options.",
        "measure": [
          {
            "param": "save_triggers",
            "unit": "list",
            "how": "when the save icon appears / what survives a restart"
          },
          {
            "param": "settings",
            "unit": "list",
            "how": "every option in the settings menu with its range"
          }
        ]
      }
    ],
    "app": [
      {
        "id": "navigation",
        "name": "Screens and navigation",
        "build": "Every screen and route, the navigation model (tabs, stack, drawer, modal), deep links, back behaviour.",
        "measure": [
          {
            "param": "screens",
            "unit": "list",
            "how": "screenshot every screen and state (empty, loading, error, full)"
          },
          {
            "param": "nav_graph",
            "unit": "graph",
            "how": "which action leads from which screen to which"
          },
          {
            "param": "transition_ms",
            "unit": "ms",
            "how": "frame-step screen transitions"
          }
        ]
      },
      {
        "id": "design-system",
        "name": "Design system",
        "build": "Own tokens for color, type scale, spacing, radius, elevation, motion; own icons and font with the same proportions.",
        "measure": [
          {
            "param": "colors",
            "unit": "hex",
            "how": "pick from screenshots (light and dark mode)"
          },
          {
            "param": "type_scale_px",
            "unit": "px at 1x",
            "how": "text heights of title, body, caption"
          },
          {
            "param": "spacing_grid_px",
            "unit": "px",
            "how": "common margins and gaps (often 4 or 8 px grid)"
          },
          {
            "param": "motion_ms_easing",
            "unit": "ms, curve",
            "how": "button press, sheet open, list insert"
          }
        ]
      },
      {
        "id": "data-model",
        "name": "Data model and state",
        "build": "Entities, fields and relations visible in the UI; local state, cache and sync.",
        "measure": [
          {
            "param": "entities",
            "unit": "list",
            "how": "every kind of thing the user creates or sees, with its visible fields and limits (max lengths, counts)"
          },
          {
            "param": "offline_behaviour",
            "unit": "notes",
            "how": "what works in airplane mode"
          }
        ]
      },
      {
        "id": "accounts",
        "name": "Accounts and onboarding",
        "build": "Sign-up/sign-in methods, onboarding steps, permissions requests, profile.",
        "measure": [
          {
            "param": "onboarding_steps",
            "unit": "list",
            "how": "every step and its order"
          },
          {
            "param": "auth_methods",
            "unit": "list",
            "how": "email, phone, social sign-in options"
          }
        ]
      },
      {
        "id": "backend-api",
        "name": "Backend and integrations",
        "build": "Your own API for the same features (REST/GraphQL), push notifications, payments, analytics.",
        "measure": [
          {
            "param": "features_needing_server",
            "unit": "list",
            "how": "what syncs across devices or between users"
          },
          {
            "param": "notifications",
            "unit": "list",
            "how": "every push/email the app sends and its trigger"
          }
        ]
      },
      {
        "id": "settings",
        "name": "Settings and edge states",
        "build": "Settings screen, errors, empty states, rate limits, accessibility.",
        "measure": [
          {
            "param": "settings",
            "unit": "list",
            "how": "every option"
          },
          {
            "param": "error_states",
            "unit": "list",
            "how": "what the app shows when things fail"
          }
        ]
      }
    ]
  },
