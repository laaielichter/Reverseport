{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.laaielichter/reverseport",
  "title": "ReversePort",
  "description": "Reverse engineer and port apps and games: Godot, Unity IL2CPP, .NET, binaries, with parity checks.",
  "websiteUrl": "https://laaielichter.github.io/Reverseport/",
  "repository": {
    "url": "https://github.com/laaielichter/reverseport",
    "source": "github"
  },
  "version": "1.17.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "reverseport",
      "version": "1.17.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
