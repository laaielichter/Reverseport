# Keep text checkouts consistent with the repository formatter on every platform.
* text=auto eol=lf

# Windows command fixtures are stored with CRLF line endings and never converted, so a checkout and an archive of
# the repository (which the Claude plugin directory validates) have the same bytes as the repository itself.
*.cmd -text

# Preserve whitespace in original upstream licensing texts.
licenses/npm-runtime-notices.txt whitespace=-blank-at-eol
